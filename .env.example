[TEMPLATE]
# Cloudinary Configuration
# 1. Create free account at https://cloudinary.com
# 2. Go to Dashboard
# 3. Copy your "Cloud Name"
# 4. Go to Settings > Upload > Upload presets
# 5. Create an "Unsigned" upload preset (or use default "ml_default")
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend (transactional emails - free tier 3,000/month, 100/day)
# 1. Create free account at https://resend.com
# 2. Go to API Keys and create a key
# 3. Verify a domain (or use onboarding@resend.dev for testing)
#
# SECURITY: The key is used SERVER-SIDE ONLY by the Vercel serverless
# function `api/send-email.ts`. It never ships to the browser. Set it in
# Vercel → Settings → Environment Variables as `RESEND_API_KEY`.
RESEND_API_KEY=
# VITE_RESEND_API_KEY is accepted as a fallback by the serverless function,
# but prefer RESEND_API_KEY so the key never reaches the client bundle.
VITE_RESEND_API_KEY=
VITE_EMAIL_FROM=MYICON <info@my-icon.shop>
# Every email is also delivered (BCC) to this inbox — shop owner's business email
VITE_EMAIL_COPY_TO=myicon2025@gmail.com
# Public shop URL (live Vercel site) — used for links inside emails and as image base
VITE_PUBLIC_URL=https://www.my-icon.shop
# Logo image shown at the top of every email (hosted on ImgBB)
VITE_EMAIL_LOGO_URL=https://i.ibb.co/60ff2bwD/logo-text-1.png
